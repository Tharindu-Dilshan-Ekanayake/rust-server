# Copy to `.env` — Colyseus loads it automatically on start.
# On Bloxity Legion none of this is needed: PORT, NODE_ENV, CLIENT_ORIGIN,
# BLOXITY_GAME_ID, BLOXITY_CHANNEL, POD_NAME (and MONGODB_URI, JWT_SECRET) are injected.

# HTTP + WebSocket port. The client defaults to http://<host>:3000.
PORT=3000

# Extra allowed origins for the /api routes (comma separated), e.g. a custom domain.
# The game's own <gameId>.play.bloxity.io / .dev.play.bloxity.io are always allowed.
# CLIENT_ORIGIN=https://modern-guns.example.com

# production = drain on SIGTERM (finish the running match, then move players on).
# NODE_ENV=production

# Seconds between "[stats]" load lines (default 60 in production, off otherwise).
# STATS_INTERVAL=10

# Testing helpers — leave unset for normal play.
# MATCH_TIME_LIMIT=60       # seconds per match (default 600)
# MATCH_SCORE_LIMIT=10      # kills to win (default 50 TDM / 25 FFA)
# DISABLE_BOTS=1            # human-only rooms
