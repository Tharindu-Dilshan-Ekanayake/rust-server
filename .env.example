# Copy to `.env` — Colyseus loads it automatically on start.

# HTTP + WebSocket port. The client defaults to http://<host>:3000.
PORT=3000

# Extra allowed origins for the /api routes (comma separated), e.g. your deployed client.
# CLIENT_ORIGIN=https://dustline.example.com

# Testing helpers — leave unset for normal play.
# MATCH_TIME_LIMIT=60       # seconds per match (default 600)
# MATCH_SCORE_LIMIT=10      # kills to win (default 50 TDM / 25 FFA)
# DISABLE_BOTS=1            # human-only rooms
